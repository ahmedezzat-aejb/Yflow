## Development Environment Configuration

AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js

## --- Yflow Branding ---
AP_BRAND_NAME=Yflow

## API Keys (Generate these for production)
AP_API_KEY=dev_api_key_123456789
AP_ENCRYPTION_KEY=abcdef1234567890abcdef1234567890
AP_JWT_SECRET=dev_jwt_secret_123456789

## Environment
AP_ENVIRONMENT=dev
AP_FRONTEND_URL=http://localhost:4200
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5

## Database Configuration (Local Development)
AP_POSTGRES_DATABASE=yflow_db
AP_POSTGRES_HOST=localhost
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=your_password

## Redis Configuration (Local Development)
AP_REDIS_HOST=localhost
AP_REDIS_PORT=6379

## Engine Configuration
AP_EXECUTION_MODE=UNSANDBOXED
AP_FLOW_TIMEOUT_SECONDS=600
AP_TELEMETRY_ENABLED=false
AP_TEMPLATES_SOURCE_URL="https://cloud.Yflow.com/api/v1/flow-templates"

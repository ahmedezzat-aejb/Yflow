{
  "name": "@yflow/server-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nx build",
    "start": "nx serve",
    "migration:run": "npx ts-node run-migrations.ts",
    "migration:generate": "npx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:generate -d src/app/database/data-source.ts",
    "migration:revert": "npx ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d src/app/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^8.0.0",
    "@nestjs/core": "^8.0.0",
    "@nestjs/platform-express": "^8.0.11",
    "@nestjs/typeorm": "^8.0.3",
    "@nestjs/jwt": "^2.3.0",
    "@nestjs/passport": "^8.2.1",
    "@nestjs/websockets": "^8.0.1",
    "@nestjs/bull": "^11.0.4",
    "@yflow/shared": "workspace:*",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcrypt": "^5.1.1",
    "pg": "8.11.3",
    "typeorm": "^0.3.20",
    "bullmq": "^5.12.0",
    "ioredis": "^5.3.2",
    "socket.io": "^4.8.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.1.11",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/supertest": "^6.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.35",
    "@types/socket.io": "^3.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4"
  }
}

{
  "name": "server-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/server/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/packages/server/api",
        "main": "packages/server/api/src/main.ts",
        "tsConfig": "packages/server/api/tsconfig.app.json",
        "webpackConfig": "packages/server/api/webpack.config.js",
        "assets": [],
        "externalDependencies": "all"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "server-api:build",
        "inspect": false
      }
    },
    "db-migration-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typeorm-ts-node-commonjs migration:generate packages/server/api/src/migrations/{args.name} -d packages/server/api/src/app/database/data-source.ts"
      }
    }
  }
}

{
  "compilerOptions": {
    "baseUrl": ".",
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "target": "ES2021",
    "paths": {
      "@Yflow/shared": ["packages/shared/src/index.ts"],
      "@Yflow/shared/*": ["packages/shared/src/*"],
      "@Yflow/common": ["packages/shared/src/index.ts"],
      "@Yflow/common/*": ["packages/shared/src/*"],
      "@Yflow/ee-shared": ["packages/ee/shared/src/index.ts"],
      "@Yflow/ee-shared/*": ["packages/ee/shared/src/*"],
      "@Yflow/pieces-framework": ["packages/pieces/framework/src/index.ts"],
      "@Yflow/pieces-framework/*": ["packages/pieces/framework/src/*"],
      "@Yflow-framework": ["packages/pieces/framework/src/index.ts"],
      "@Yflow/pieces-common": ["packages/pieces/common/src/index.ts"],
      "@Yflow/pieces-common/*": ["packages/pieces/common/src/*"],
      "@Yflow/import-fresh-webpack": ["packages/import-fresh-webpack/src/index.ts"],
      "@Yflow/import-fresh-webpack/*": ["packages/import-fresh-webpack/src/*"],
      "@Yflow": ["packages/shared/src/index.ts"],
      "@Yflow/*": ["packages/shared/src/*"],
      "yflow-core": ["packages/shared/src/index.ts"],
      "yflow-core/*": ["packages/shared/src/*"],
      "@yflow/server/api": ["packages/server/api/src/index.ts"],
      "@yflow/server/api/*": ["packages/server/api/src/*"],
      "@yflow/server": ["packages/server/api/src/index.ts"],
      "@yflow/server/*": ["packages/server/api/src/*"],
      "@Yflow/engine": ["packages/engine/src/index.ts"],
      "@Yflow/engine/*": ["packages/engine/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
